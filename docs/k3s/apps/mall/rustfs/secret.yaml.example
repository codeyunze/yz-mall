# 复制为 secret.yaml 后改密钥再 apply；勿把真实密钥提交 Git
# 推荐：kubectl -n mall create secret generic rustfs-secret \
#   --from-literal=access-key='你的AccessKey' \
#   --from-literal=secret-key='你的SecretKey'
apiVersion: v1
kind: Secret
metadata:
  name: rustfs-secret
  namespace: mall
  labels:
    app.kubernetes.io/name: rustfs
    app.kubernetes.io/part-of: yz-mall
type: Opaque
stringData:
  access-key: "请改成强口令AccessKey"
  secret-key: "请改成强口令SecretKey"
