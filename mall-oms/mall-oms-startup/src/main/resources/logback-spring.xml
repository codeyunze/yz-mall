<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <!-- 关闭 Status 控制台输出，避免 Logstash 启动首连超时刷 |-WARN；不影响业务日志与自动重连上报 -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <!--从 spring.application.name 读取服务名，日志目录与 Logstash 标签自动跟随，新模块只需配置服务名即可-->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="application"/>
    <property name="LOG_HOME" value="./logs/${APP_NAME}/"/>

    <!--控制台：仅保留 TID（SW_CTX 与 TID 重复且过长，检索用 Logstash/OAP 即可）-->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <charset>UTF-8</charset>
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                <pattern>%green(%d{yyyy-MM-dd HH:mm:ss.SSS}) %magenta([%thread]) %highlight(%-5level) %cyan([%X{tid}]) %logger{72} - %msg%n</pattern>
            </layout>
        </encoder>
    </appender>

    <appender name="timeFileOutput" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <File>${LOG_HOME}/out.log</File>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <FileNamePattern>${LOG_HOME}/info.%d{yyyy-MM-dd}.%i.log.gz</FileNamePattern>
            <MaxHistory>30</MaxHistory>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <charset>UTF-8</charset>
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{tid}] %logger{72} - %msg%n</pattern>
            </layout>
        </encoder>
    </appender>

    <appender name="logstash" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>192.168.3.237:4560</destination>
        <!-- 启动期默认 5s 易超时，拉长首连等待 -->
        <connectionTimeout>30000</connectionTimeout>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"platform": "mall", "app_name": "${APP_NAME}"}</customFields>
            <includeMdcKeyName>client_ip</includeMdcKeyName>
            <!-- <provider class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.logstash.TraceIdJsonProvider"/> -->
            <!-- <provider class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.logstash.SkyWalkingContextJsonProvider"/> -->
        </encoder>
    </appender>

    <!-- SkyWalking：日志上报 OAP（需挂载 Java Agent） -->
    <appender name="skywalking" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{tid}] [%thread] %-5level %logger{50} - %msg%n</pattern>
            </layout>
        </encoder>
    </appender>

    <springProperty scope="context" name="MAPPER_PACKAGE" source="logging.mapper-package" defaultValue="com.yz.mall"/>
    <logger name="${MAPPER_PACKAGE}" level="DEBUG"/>
    <logger name="io.github.codeyunze.mapper" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="console"/>
        <appender-ref ref="timeFileOutput"/>
        <appender-ref ref="logstash"/>
        <appender-ref ref="skywalking"/>
    </root>
</configuration>
